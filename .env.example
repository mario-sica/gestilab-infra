# Ambiente di runtime per il profilo prod: legge queste variabili sia
# compose.yaml (la base, in gestilab-app) sia compose.prod.yaml (qui). Vive
# qui, non in gestilab-app, perché Docker Compose legge ".env" dalla
# directory da cui si invoca il comando (vedi README.md § Deploy) — e per
# prod si invoca da questo repository, dove vivono anche i segreti reali
# (mai versionati: .env è in .gitignore, questo è solo il template).
#
# Ogni valore "CAMBIA-QUESTO" è un placeholder: nessuno di questi va usato
# davvero in produzione. Le password di sviluppo in gestilab-app/.env.example
# NON vanno riusate qui.

# Dominio di base: unica fonte del dominio nell'intero sistema, letta anche
# da Docker Compose stesso per interpolare ${BASE_DOMAIN} nelle label di
# routing Traefik (compose.prod.yaml).
BASE_DOMAIN=gestilab.it

# Porta e host su cui apps/api resta in ascolto (nella rete Docker interna,
# non esposta all'host: solo Traefik pubblica 80/443).
API_PORT=3001
API_HOST=0.0.0.0

# Utente, password e nome del database applicativo in PostgreSQL.
POSTGRES_USER=gestilab
POSTGRES_PASSWORD=CAMBIA-QUESTO
POSTGRES_DB=gestilab

# Connessione applicativa (ruolo "gestilab_app", non owner — creato dalla
# migrazione 0000 di gestilab-app/packages/db/migrations).
DATABASE_URL=postgres://gestilab_app:CAMBIA-QUESTO@db:5432/gestilab

# Connessione owner: usata SOLO dalle migrazioni, mai dal codice applicativo.
DATABASE_MIGRATE_URL=postgres://gestilab:CAMBIA-QUESTO@db:5432/gestilab

# Redis per code e cache.
REDIS_URL=redis://redis:6379

# Storage S3-compatibile. In produzione può essere un servizio esterno UE
# invece del MinIO in container (vedi docs/02-architettura.md in
# gestilab-app § Servizi) — in tal caso sostituire endpoint e credenziali.
S3_ENDPOINT=http://storage:9000
S3_BUCKET=gestilab-prod
MINIO_ROOT_USER=gestilab
MINIO_ROOT_PASSWORD=CAMBIA-QUESTO

# SMTP per l'invio email: in produzione un provider reale, non Mailpit.
SMTP_URL=smtp://CAMBIA-QUESTO

LOG_LEVEL=info

# GlitchTip (error tracking, API compatibile Sentry).
GLITCHTIP_SECRET_KEY=CAMBIA-QUESTO
GLITCHTIP_DATABASE_URL=postgres://gestilab:CAMBIA-QUESTO@db:5432/glitchtip
GLITCHTIP_REDIS_URL=redis://redis:6379/1
GLITCHTIP_EMAIL_URL=smtp://CAMBIA-QUESTO
GLITCHTIP_DOMAIN=https://status.gestilab.it

# Email per le notifiche di scadenza del certificato Let's Encrypt.
ACME_EMAIL=

# Nome del provider DNS usato da Traefik per la sfida DNS-01 (vedi la
# documentazione di Traefik sui provider DNS supportati). Il provider scelto
# richiede anche le proprie variabili di autenticazione (token/chiave API):
# da aggiungere qui quando si sceglie il provider, mai versionarle.
DNS_PROVIDER=
